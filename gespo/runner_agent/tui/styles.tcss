/* GESPO Agent TUI — OpenCode-style theme */

Screen {
    background: $surface;
}

/* ── Header ─────────────────────────────────────────────────────── */

#header {
    dock: top;
    height: 1;
    background: $primary-darken-3;
    color: $text;
    padding: 0 1;
}

#header .label {
    text-style: bold;
}

/* ── Chat area ──────────────────────────────────────────────────── */

#chat-scroll {
    height: 1fr;
    padding: 0 1;
    scrollbar-size: 1 1;
}

/* ── Message bubbles ────────────────────────────────────────────── */

.message {
    margin: 1 0 0 0;
    padding: 0 1;
    width: 100%;
}

.message-role {
    text-style: bold;
    margin: 0 0 0 0;
}

.user-role {
    color: $success;
}

.assistant-role {
    color: $primary-lighten-2;
}

.system-role {
    color: $text-muted;
}

.message-body {
    margin: 0 0 0 2;
}

/* ── Tool call panels ───────────────────────────────────────────── */

.tool-call {
    margin: 1 0 0 2;
    border: round $accent;
    padding: 0 1;
    height: auto;
    max-height: 20;
}

.tool-call.-collapsed {
    max-height: 3;
}

.tool-header {
    text-style: bold;
    color: $accent;
}

.tool-header-success {
    color: $success;
}

.tool-header-error {
    color: $error;
}

.tool-params {
    color: $text-muted;
    margin: 0 0 0 2;
}

.tool-output {
    margin: 0 0 0 2;
    color: $text;
}

.tool-timing {
    color: $text-muted;
    text-style: italic;
}

/* ── Input area ─────────────────────────────────────────────────── */

#input-container {
    dock: bottom;
    height: auto;
    max-height: 8;
    padding: 0 1;
    background: $surface-darken-1;
    border-top: solid $primary-darken-2;
}

#prompt-input {
    margin: 0;
    border: round $primary-darken-1;
    padding: 0 1;
    min-height: 1;
    max-height: 6;
}

#prompt-input:focus {
    border: round $primary;
}

/* ── Footer / status ────────────────────────────────────────────── */

#footer {
    dock: bottom;
    height: 1;
    background: $primary-darken-3;
    color: $text-muted;
    padding: 0 1;
}

.key-hint {
    color: $accent;
    text-style: bold;
    margin: 0 0 0 1;
}

.key-desc {
    color: $text-muted;
    margin: 0 1 0 0;
}

/* ── Approval dialog ────────────────────────────────────────────── */

#approval-dialog {
    align: center middle;
    width: 70;
    max-width: 90%;
    height: auto;
    max-height: 20;
    border: thick $warning;
    padding: 1 2;
    background: $surface;
}

#approval-dialog .title {
    text-style: bold;
    color: $warning;
    text-align: center;
    margin: 0 0 1 0;
}

#approval-buttons {
    height: 3;
    align: center middle;
    margin: 1 0 0 0;
}

#approval-buttons Button {
    margin: 0 1;
}

/* ── Welcome / empty state ──────────────────────────────────────── */

#welcome {
    align: center middle;
    width: 100%;
    height: 100%;
}

#welcome-text {
    text-align: center;
    color: $text-muted;
    margin: 1;
}

#welcome-title {
    text-style: bold;
    color: $primary-lighten-1;
    text-align: center;
}

/* ── Thinking indicator ─────────────────────────────────────────── */

#thinking {
    margin: 1 0 0 2;
    color: $text-muted;
    text-style: italic;
}
